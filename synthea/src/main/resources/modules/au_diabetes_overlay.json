{
  "name": "AU Diabetes Overlay",
  "remarks": [
    "Australian-specific Type 2 Diabetes current prevalence.",
    "AIHW 2023: 6.7% of Australians currently have diabetes.",
    "Sets both the ConditionOnset (for OMOP ETL mapping) and the 'diabetes'",
    "attribute via a separate SetAttribute state (required by",
    "metabolic_syndrome_care.json and complication sub-modules to drive",
    "nephropathy, retinopathy, etc.).",
    "Also initialises diabetic_retinopathy_stage=0, macular_edema=false, and",
    "diabetic_nerve_damage=0 — required by diabetic_retinopathy_treatment.json",
    "which would otherwise crash with a lookup table error.",
    "metabolic_syndrome_disease.json is disabled to prevent double-counting."
  ],
  "states": {
    "Initial": {
      "type": "Initial",
      "distributed_transition": [
        {
          "distribution": 0.067,
          "transition": "Onset_Diabetes"
        },
        {
          "distribution": 0.933,
          "transition": "Terminal"
        }
      ]
    },
    "Onset_Diabetes": {
      "type": "ConditionOnset",
      "codes": [
        {
          "system": "SNOMED-CT",
          "code": "44054006",
          "display": "Diabetes mellitus type 2 (disorder)"
        }
      ],
      "direct_transition": "Set_Diabetes_Attribute"
    },
    "Set_Diabetes_Attribute": {
      "type": "SetAttribute",
      "attribute": "diabetes",
      "value": true,
      "direct_transition": "Init_Retinopathy_Stage"
    },
    "Init_Retinopathy_Stage": {
      "type": "SetAttribute",
      "attribute": "diabetic_retinopathy_stage",
      "value": 0,
      "direct_transition": "Init_Macular_Edema"
    },
    "Init_Macular_Edema": {
      "type": "SetAttribute",
      "attribute": "macular_edema",
      "value": false,
      "direct_transition": "Init_Nerve_Damage"
    },
    "Init_Nerve_Damage": {
      "type": "SetAttribute",
      "attribute": "diabetic_nerve_damage",
      "value": 0,
      "direct_transition": "Terminal"
    },
    "Terminal": {
      "type": "Terminal"
    }
  },
  "gmf_version": 2
}
